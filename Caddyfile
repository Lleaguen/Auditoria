{
    local_certs
}

https://172.19.40.207 {
    tls internal

    log {
        output file "C:/caddy/logs/access.log"
        format json
    }

    @options method OPTIONS
    header @options Access-Control-Allow-Origin "https://lleaguen.github.io"
    header @options Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    header @options Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
    header @options Access-Control-Max-Age "3600"
    respond @options 204

    header {
        Access-Control-Allow-Origin  "https://lleaguen.github.io"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
        -Server
        -X-Powered-By
    }

    request_body {
        max_size 50MB
    }

    handle {
        reverse_proxy localhost:3001 {
            header_up -Access-Control-Allow-Origin
            header_up -Access-Control-Allow-Methods
            header_up -Access-Control-Allow-Headers
        }
    }
}
