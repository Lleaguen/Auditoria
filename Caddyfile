# Caddyfile — Proxy reverso para audit-backend
# Máquina: 192.168.67.121
# Backend Express corre en localhost:3001

# ── HTTP → HTTPS ──────────────────────────────────────────────────────────────
:80 {
    redir https://{host}{uri} permanent
}

# ── HTTPS principal ───────────────────────────────────────────────────────────
:443 {
    # Certificado self-signed para uso interno (sin dominio público)
    tls internal

    # ── Log de accesos ────────────────────────────────────────────────────────
    log {
        output file "C:/caddy/logs/access.log"
        format json
    }

    # ── Cabeceras de seguridad ────────────────────────────────────────────────
    header {
        # CORS — solo acepta requests desde GitHub Pages
        Access-Control-Allow-Origin  "https://lleaguen.github.io"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
        Access-Control-Max-Age       "3600"

        # Ocultar tecnología del servidor
        -Server
        -X-Powered-By

        # Seguridad HTTP
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "no-referrer"
    }

    # ── Preflight CORS (OPTIONS) — responder sin tocar el backend ─────────────
    @options method OPTIONS
    respond @options 204

    # ── Rate limit estricto en login para prevenir fuerza bruta ──────────────
    @login_path path /api/auth/login
    handle @login_path {
        rate_limit {remote_host} 5r/m
        reverse_proxy localhost:3001 {
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Proxy al backend Express ──────────────────────────────────────────────
    handle {
        reverse_proxy localhost:3001 {
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Health check automático del backend
            health_uri      /health
            health_interval 30s
            health_timeout  5s
        }
    }
}
