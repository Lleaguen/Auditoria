# Copiá este archivo como .env y completá con tus valores

# Puerto del servidor Express
PORT=3001

# Origen del frontend deployado (para CORS)
# Ejemplo: https://mi-app.vercel.app
ALLOWED_ORIGIN=https://tu-frontend.vercel.app

# Conexión a PostgreSQL
# Opción A — URL completa (Neon u otros proveedores cloud):
DATABASE_URL=postgresql://usuario:password@host/dbname?sslmode=require

# Opción B — Variables individuales (desarrollo local):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=audit_db
# DB_USER=francoromero
# DB_PASSWORD=

# Secreto JWT — usá una cadena aleatoria larga (mínimo 32 chars)
# Generá uno con: openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_en_produccion_min32chars
JWT_EXPIRES_IN=8h

# API Keys por planta — el frontend las manda en el header X-Api-Key
# Si ambas están vacías, el backend no exige clave (solo para desarrollo local)
# Generá strings aleatorios, ej: openssl rand -hex 32
API_KEY_CIU=clave_secreta_soldati_aqui
API_KEY_EEV=clave_secreta_echeverria_aqui

# Horario del backup automático diario (cron expression, hora del servidor)
# Formato: minuto hora * * *
# Ejemplo: 10:00 AM todos los días → '0 10 * * *'
BACKUP_CRON=0 10 * * *

# Configuración del email de backup (via Resend)
# Obtené tu API key en https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKUP_EMAIL_TO=franco.nahuel.romero@ocasa.com
BACKUP_EMAIL_FROM=onboarding@resend.dev
